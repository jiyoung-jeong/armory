{
  "experiment": {
    "env": "libero",
    "task_suite_name": "libero_10",
    "action_chunk_broker_type": "naive_async",
    "num_robots": 2,
    "trials_per_robot": 1,
    "max_steps": 200,
    "control_hz": 20
  },
  "toxiproxy": {
    "api_url": "http://127.0.0.1:8474",
    "listen_host": "127.0.0.1",
    "listen_port_base": 15000,
    "server_args": []
  },
  "sampling": {
    "default_seed": 7,
    "resample_every_requests": 1
  },
  "robots": {
    "robot_0": {
      "min_execution_horizon": 0,
      "max_execution_horizon": 4,
      "uplink_median_ms": 0.0,
      "uplink_sigma": 0.0,
      "downlink_median_ms": 0.0,
      "downlink_sigma": 0.0
    },
    "robot_1": {
      "min_execution_horizon": 0,
      "max_execution_horizon": 10,
      "uplink_median_ms": 0.0,
      "uplink_sigma": 0.0,
      "downlink_median_ms": 0.0,
      "downlink_sigma": 0.0
    }
  }
}
