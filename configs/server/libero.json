{
  "env": "libero",
  "model": "pi05",
  "port": 8080,
  "policy": {
    "type": "default"
  },
  "server": {
    "max_batch_size": 3,
    "scheduler": {
      "scheduling_algorithm": "lookahead-actions",
      "alpha": 1.0
    },
    "engine": {
      "num_steps": 10
    }
  },
  "log_level": "INFO"
}
